<IfModule mod_mime.c>
  AddType application/javascript .mjs
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Usar el mismo origen que la app Android instalada para compartir la sesión profesional.
  RewriteCond %{HTTP_HOST} ^(?:drhappy\.com\.ar|www\.drhappy\.com\.ar)$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^drhappy\.com\.ar$ [NC]
  RewriteRule ^ https://www.drhappy.com.ar%{REQUEST_URI} [R=301,L,NE]

  # Link fijo de la turnera: /turnera/nombre-profesional -> página pública de turnos.
  RewriteRule ^turnera/([a-z0-9-]+)/gratis/?$ /turnos/?p=$1&m=gratis [R=302,L,QSA]
  RewriteRule ^turnera/([a-z0-9-]+)/?$ /turnos/?p=$1 [R=302,L,QSA]
  # Invitación para que el paciente se registre: /registro/token -> formulario público.
  RewriteRule ^registro/([a-z0-9-]+)/?$ /registro/?t=$1 [R=302,L,QSA]
  # Consulta virtual asistida: /consulta/slug -> formulario público pago.
  RewriteRule ^consulta/([a-z0-9-]+)/?$ /consulta/?p=$1 [R=302,L,QSA]
  # Certificados y órdenes pagas: enlace fijo público independiente.
  RewriteRule ^documentos/([a-z0-9-]+)/?$ /index.html?paid_documents_slug=$1 [QSA,L]
  # Carpeta de Salud del paciente: acceso independiente de la app profesional.
  RewriteRule ^paciente/?$ /index.html?patient_portal=1 [QSA,L]
</IfModule>
